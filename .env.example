# Copy to .env.local for development and add the same keys in Vercel → Settings → Environment Variables.

# Public site URL (no trailing slash). On Vercel this falls back to the production domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Sanity (sanity.io/manage). Leave the project ID empty to run on placeholder content.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Viewer token, only needed if the dataset is private.
SANITY_API_READ_TOKEN=
# Shared secret for the Sanity → /api/revalidate webhook.
SANITY_REVALIDATE_SECRET=

# Resend (resend.com). QUOTE_FROM_EMAIL must use a domain verified in Resend.
RESEND_API_KEY=
QUOTE_TO_EMAIL=citrixsolutionsltd2025@gmail.com
QUOTE_FROM_EMAIL=Citrix Solutions <quotes@citrixsolutions.co.ug>
